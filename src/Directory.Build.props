<Project>
  <!--
    Shared settings for our own projects. This file lives in src/ (and is imported from tests/)
    rather than at the repo root on purpose: MSBuild imports the nearest Directory.Build.props
    walking upwards, and a root-level file would also apply to external/unattend-generator.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
</Project>
